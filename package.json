{
  "name": "personal-blog",
  "type": "module",
  "version": "1.0.0",
  "description": "A personal site theme for Astro — portfolio, blog, and travel photo galleries in one quiet, fast template.",
  "keywords": [
    "astro",
    "astro-theme",
    "template",
    "blog",
    "portfolio",
    "personal-site",
    "travel",
    "photography"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && cp -r dist/client/* dist/",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.0",
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/react": "^6.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.6.9",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "astro": "^7.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild": true
  }
}
