---
import { educations } from '../data/resume';
---

<section class="section" id="education">
  <div class="container">
    <p class="eyebrow">Education</p>
    <h2 class="section-heading">Education</h2>
    <div class="edu-grid">
      {
        educations.map((e) => (
          <div class="card">
            <p class="muted" style="font-family: var(--font-mono); font-size: 0.8rem; margin: 0 0 0.4rem;">
              {e.start} – {e.end}
            </p>
            <h3>{e.degree}</h3>
            <p style="margin: 0 0 0.2rem; font-weight: 600; color: var(--text-strong);">{e.field}</p>
            <p class="muted" style="margin: 0;">{e.school}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
