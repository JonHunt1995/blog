---
import Layout from '../../components/Layout.astro';
import Icon from '../../components/Icon.astro';
import Figure from '../../components/Figure.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { site, withBase } from '../../data/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

type Props = { project: CollectionEntry<'projects'> };

const { project } = Astro.props;
const { Content } = await render(project);

const dateFmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long' });
const heroImage = typeof project.data.heroImage === 'object' 
  ? project.data.heroImage 
  : (project.data.heroImage ? withBase(project.data.heroImage) : undefined);

const ogImage = typeof project.data.heroImage === 'object' 
  ? project.data.heroImage.src 
  : (project.data.heroImage ?? '/img/og.jpg');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: project.data.title,
  description: project.data.description,
  author: { '@type': 'Person', name: site.author.name },
  ...(ogImage && { image: `${site.url}${ogImage}` }),
};
---

<Layout
  title={project.data.title}
  description={project.data.description}
  type="article"
  image={ogImage}
  jsonLd={jsonLd}
>
  <article class="section">
    <div class="container">
      <nav aria-label="Breadcrumb" style="margin-bottom: 1.5rem;">
        <a href={withBase('/projects')}><Icon name="arrow-left" size={14} /> Back to projects</a>
      </nav>

      <header>
        {project.data.date && (
          <div class="post-meta">
            <time datetime={project.data.date.toISOString()}>{dateFmt.format(project.data.date)}</time>
          </div>
        )}
        <h1 style="margin: 0.75rem 0 0.5rem;">{project.data.title}</h1>
        {project.data.tagline && <p class="tagline" style="font-size: 1.15rem; margin-bottom: 0.5rem;">{project.data.tagline}</p>}
        <p class="muted" style="font-size: 1.05rem;">{project.data.description}</p>

        {project.data.tags.length > 0 && (
          <div class="tag-list" style="margin: 1rem 0;">
            {project.data.tags.map((t) => <span class="tag">#{t}</span>)}
          </div>
        )}

        <div style="display: flex; gap: 1rem; margin-top: 1.25rem;">
          {project.data.githubUrl && (
            <a href={project.data.githubUrl} target="_blank" rel="noopener" class="btn" style="display: inline-flex; align-items: center; gap: 0.5rem;">
              <Icon name="github" size={16} /> GitHub
            </a>
          )}
          {project.data.demoUrl && (
            <a href={project.data.demoUrl} target="_blank" rel="noopener" class="btn" style="display: inline-flex; align-items: center; gap: 0.5rem;">
              <Icon name="external-link" size={16} /> Live Demo
            </a>
          )}
        </div>
      </header>

      {heroImage && (
        typeof heroImage === 'object' ? (
          <Image
            src={heroImage}
            alt={project.data.title}
            style="border-radius: var(--radius-lg); margin: 2rem 0; width: 100%; object-fit: cover; max-height: 440px;"
          />
        ) : (
          <img
            src={heroImage}
            alt={project.data.title}
            style="border-radius: var(--radius-lg); margin: 2rem 0; width: 100%; object-fit: cover; max-height: 440px;"
          />
        )
      )}

      {project.data.highlights.length > 0 && (
        <ul class="badge-row" style="list-style: none; padding: 0; margin: 1.5rem 0;">
          {project.data.highlights.map((h) => <li class="badge">✦ {h}</li>)}
        </ul>
      )}

      <div class="prose" style="margin-top: 2rem;">
        <Content components={{ Figure }} />
      </div>

      <nav aria-label="Projects navigation" style="margin-top: 3rem;">
        <a href={withBase('/projects')}><Icon name="arrow-left" size={14} /> Back to all projects</a>
      </nav>
    </div>
  </article>
</Layout>

